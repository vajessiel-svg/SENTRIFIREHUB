# Copy this file to .env and replace every CHANGE_ME value on the Raspberry Pi.
APP_ENV=development
SENTRIFIRE_HOST=0.0.0.0
SENTRIFIRE_PORT=8000
SENTRIFIRE_SECRET_KEY=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
SENTRIFIRE_OWNER_NAME=Owner
SENTRIFIRE_OWNER_EMAIL=owner@sentrifire.local
SENTRIFIRE_OWNER_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD
SENTRIFIRE_DATABASE_PATH=data/sentrifire.db
SENTRIFIRE_MODEL_PATH=models/best.pt
SENTRIFIRE_SNAPSHOT_DIR=data/snapshots
SENTRIFIRE_PUBLIC_BASE_URL=http://192.168.1.50:8000
SENTRIFIRE_STREAM_BASE_URL=http://192.168.1.50:8888
SENTRIFIRE_ALLOWED_ORIGINS=*

# Start with balanced. Valid values: high, balanced, reduced_false_alarms.
SENTRIFIRE_SENSITIVITY=balanced
# Leave blank to use the selected preset, or enter 0.05-0.95 for an override.
SENTRIFIRE_ADVANCED_CONFIDENCE=

# GPIO BCM numbering. Change these to match the final wiring.
SENTRIFIRE_GPIO_ENABLED=false
SENTRIFIRE_RELAY_PIN=17
SENTRIFIRE_RELAY_ACTIVE_LOW=true
SENTRIFIRE_RED_LED_PIN=27
SENTRIFIRE_GREEN_LED_PIN=22

# Optional Firebase Admin service-account JSON file for remote push notifications.
FIREBASE_SERVICE_ACCOUNT=

# Tapo camera accounts are created in Tapo App > Camera > Advanced Settings.
# Use stream2 for AI detection. Never commit real credentials.
CAMERA_1_ID=cam-001
CAMERA_1_NAME=Camera 1
CAMERA_1_LOCATION=Location 1
# MediaMTX pulls each Tapo feed once and republishes it locally. Detection
# should read the local paths below so each camera does not serve two clients.
CAMERA_1_RTSP_URL=rtsp://127.0.0.1:8554/cam1
CAMERA_1_STREAM_PATH=cam1
CAMERA_1_ENABLED=true

CAMERA_2_ID=cam-002
CAMERA_2_NAME=Camera 2
CAMERA_2_LOCATION=Location 2
CAMERA_2_RTSP_URL=rtsp://127.0.0.1:8554/cam2
CAMERA_2_STREAM_PATH=cam2
CAMERA_2_ENABLED=true

CAMERA_3_ID=cam-003
CAMERA_3_NAME=Camera 3
CAMERA_3_LOCATION=Location 3
CAMERA_3_RTSP_URL=rtsp://127.0.0.1:8554/cam3
CAMERA_3_STREAM_PATH=cam3
CAMERA_3_ENABLED=true
